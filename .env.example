# Copy to .env and fill in. Never commit the real .env file.

# Google AI Studio Gemini API key (free tier, no billing account required).
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model tiering — see TRD.md section 8 for why these are split this way.
# NOTE: TRD.md names the gemini-2.5-* series, but as of implementation time
# those models return 404 "no longer available to new users" on freshly
# created API keys — replaced by the gemini-3.5-* series. See DECISION_LOG.md.
CLASSIFIER_MODEL=gemini-3.5-flash-lite
GENERATION_MODEL=gemini-3.5-flash
JUDGE_MODEL=gemini-3.5-flash

# Local embedding model (sentence-transformers), downloaded once from Hugging Face.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# If unset, pipeline falls back to a local Ollama model for generation/judging.
# See README for the adjusted (slower) expectations of that path.
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

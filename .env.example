# Copy to .env and fill in. Never commit the real .env file.

# Google AI Studio Gemini API key (free tier, no billing account required).
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Model tiering — see TRD.md section 8 for why these are split this way.
# NOTE: TRD.md names the gemini-2.5-* series, but as of implementation time
# those models return 404 "no longer available to new users" on freshly
# created API keys — replaced by the gemini-3.5-* series. See DECISION_LOG.md.
# NOTE 2: gemini-3.5-flash carries only a 20 requests/day free-tier quota on
# a freshly created key (empirically observed, not documented anywhere) —
# nowhere near enough for a 200-example golden-set run. Everything uses
# gemini-3.5-flash-lite instead, which has a much higher daily quota.
CLASSIFIER_MODEL=gemini-3.5-flash-lite
GENERATION_MODEL=gemini-3.5-flash-lite
JUDGE_MODEL=gemini-3.5-flash-lite

# Local embedding model (sentence-transformers), downloaded once from Hugging Face.
EMBEDDING_MODEL=all-MiniLM-L6-v2

# If unset, pipeline falls back to a local Ollama model for generation/judging.
# See README for the adjusted (slower) expectations of that path.
OLLAMA_MODEL=llama3.1:8b
OLLAMA_BASE_URL=http://localhost:11434

# Comma-separated origins allowed to call the API (CORS). Defaults to the
# Next.js dev server; add the deployed frontend URL here in production.
CORS_ALLOWED_ORIGINS=http://localhost:3000
